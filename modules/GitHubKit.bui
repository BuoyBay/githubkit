' Synchronous GitHub REST client. Run network operations on a worker thread.

Private Sub CheckText(value As String, label As String)
    Dim encoded As Bytes = Bytes.FromString(value, Text.Encodings.UTF8)
    For i As Integer = 0 To encoded.Count - 1
        If encoded.Item(i) < 32 Or encoded.Item(i) = 127 Then Throw New InvalidArgumentException(label + " contains a control character")
    Next
End Sub

Private Function Segment(value As String) As String
    CheckText(value, "Path segment")
    If value = "" Or value = "." Or value = ".." Or String.Contains(value, "/") Or String.Contains(value, "\\") Then Throw New InvalidArgumentException("Invalid repository path segment")
    Dim encoded As Bytes = Bytes.FromString(value, Text.Encodings.UTF8)
    Dim output As String = ""
    Dim hexDigits As String = "0123456789ABCDEF"
    For i As Integer = 0 To encoded.Count - 1
        Dim n As Integer = encoded.Item(i)
        If (n >= 65 And n <= 90) Or (n >= 97 And n <= 122) Or (n >= 48 And n <= 57) Or n = 45 Or n = 46 Or n = 95 Or n = 126 Then
            output += String.Chr(n)
        Else
            output += "%" + String.Substring(hexDigits, n \ 16, 1) + String.Substring(hexDigits, n Mod 16, 1)
        End If
    Next
    Return output
End Function

Private Function IntegerField(item As JSONItem, key As String) As Integer
    Dim value As JSONItem = item.Value(key)
    If value.IsNull() Then Return 0
    If Not value.IsNumber() Then Throw New InvalidArgumentException("Expected a numeric GitHub identifier")
    Dim number As Double = value.AsNumber().Value
    If number <> number Or number < 0.0 Or number > 9007199254740991.0 Then Throw New InvalidArgumentException("GitHub identifier exceeds JSON's exact integer range")
    Dim exact As Integer = number
    If exact <> number Then Throw New InvalidArgumentException("Expected an integer GitHub identifier")
    Return exact
End Function

Private Function HeaderValue(connection As URLConnection, headerName As String) As String
    For Each entry In connection.ResponseHeaders.Entries()
        If String.LCase(entry.Key) = String.LCase(headerName) Then Return entry.Value
    Next
    Return ""
End Function

Private Function RepositoryRoute(owner As String, repository As String) As String
    Return "/repos/" + Segment(owner) + "/" + Segment(repository)
End Function

Private Function ItemRoute(owner As String, repository As String, kind As String, number As Integer) As String
    If number < 1 Then Throw New InvalidArgumentException("Issue/pull request number must be positive")
    Return RepositoryRoute(owner, repository) + "/" + kind + "/" + String.From(number)
End Function

Private Function PageSuffix(page As Integer, perPage As Integer, state As String) As String
    If page < 1 Or perPage < 1 Or perPage > 100 Then Throw New InvalidArgumentException("Page must be positive and perPage in 1..100")
    Dim suffix As String = "?page=" + String.From(page) + "&per_page=" + String.From(perPage)
    If state <> "" Then
        If state <> "open" And state <> "closed" And state <> "all" Then Throw New InvalidArgumentException("Invalid issue state")
        suffix += "&state=" + state
    End If
    Return suffix
End Function

Public Class GitHubResponseInfo
    Public Property Status As Integer
    Public Property RequestID As String
    Public Property RateLimitRemaining As String
    Public Property RateLimitReset As String
    Public Property RetryAfter As String
    Public Property Link As String

    Internal Sub Constructor(connection As URLConnection)
        Me.Status = connection.HTTPStatus
        Me.RequestID = HeaderValue(connection, "X-GitHub-Request-Id")
        Me.RateLimitRemaining = HeaderValue(connection, "X-RateLimit-Remaining")
        Me.RateLimitReset = HeaderValue(connection, "X-RateLimit-Reset")
        Me.RetryAfter = HeaderValue(connection, "Retry-After")
        Me.Link = HeaderValue(connection, "Link")
    End Sub
End Class

Public Class GitHubAPIException Inherits Exception
    Public Property ResponseInfo As GitHubResponseInfo

    Internal Sub Constructor(message As String, info As GitHubResponseInfo)
        Super.Constructor(message, info.Status)
        Me.ResponseInfo = info
    End Sub
End Class

Public Class GitHubPageInfo
    Public Property Page As Integer
    Public Property PerPage As Integer
    Public Property HasNext As Boolean
    Public Property ResponseInfo As GitHubResponseInfo

    Internal Sub Constructor(page As Integer, perPage As Integer, info As GitHubResponseInfo)
        Me.Page = page
        Me.PerPage = perPage
        Me.ResponseInfo = info
        For Each part As String In String.Split(info.Link, ",")
            If String.Contains(part, "rel=\"next\"") Then Me.HasNext = True
        Next
    End Sub
End Class

Public Class GitHubRepository
    Public Property RawJSON As JSONItem
    Public Property ID As Integer
    Public Property Name As String
    Public Property FullName As String
    Public Property HTMLURL As String
    Public Property Description As String
    Public Property DefaultBranch As String
    Public Property IsPrivate As Boolean

    Internal Sub Constructor(raw As JSONItem)
        If Not raw.IsObject() Then Throw New InvalidArgumentException("Expected a GitHub object")
        Me.RawJSON = raw
        Me.ID = IntegerField(raw, "id")
        Me.Name = raw.Value("name").AsString().Or("")
        Me.FullName = raw.Value("full_name").AsString().Or("")
        Me.HTMLURL = raw.Value("html_url").AsString().Or("")
        Me.Description = raw.Value("description").AsString().Or("")
        Me.DefaultBranch = raw.Value("default_branch").AsString().Or("")
        Me.IsPrivate = raw.Value("private").AsBoolean().Or(False)
    End Sub
End Class

Public Class GitHubIssue
    Public Property RawJSON As JSONItem
    Public Property ID As Integer
    Public Property Number As Integer
    Public Property Title As String
    Public Property Body As String
    Public Property State As String
    Public Property HTMLURL As String
    Public Property CreatedAt As String
    Public Property UpdatedAt As String
    Public Property Author As String
    Public Property IsPullRequest As Boolean

    Internal Sub Constructor(raw As JSONItem)
        If Not raw.IsObject() Then Throw New InvalidArgumentException("Expected a GitHub object")
        Me.RawJSON = raw
        Me.ID = IntegerField(raw, "id")
        Me.Number = IntegerField(raw, "number")
        Me.Title = raw.Value("title").AsString().Or("")
        Me.Body = raw.Value("body").AsString().Or("")
        Me.State = raw.Value("state").AsString().Or("")
        Me.HTMLURL = raw.Value("html_url").AsString().Or("")
        Me.CreatedAt = raw.Value("created_at").AsString().Or("")
        Me.UpdatedAt = raw.Value("updated_at").AsString().Or("")
        Me.Author = raw.Value("user").Value("login").AsString().Or("")
        Me.IsPullRequest = raw.Value("pull_request").IsObject()
    End Sub
End Class

Public Class GitHubIssuePage
    Public Property Items As Array Of GitHubIssue
    Public Property Info As GitHubPageInfo
    Public Property RawJSON As JSONItem

    Internal Sub Constructor(raw As JSONItem, page As Integer, perPage As Integer, info As GitHubResponseInfo)
        If Not raw.IsArray() Then Throw New InvalidArgumentException("Expected a GitHub array")
        Me.RawJSON = raw
        Me.Info = New GitHubPageInfo(page, perPage, info)
        Dim values(0) As GitHubIssue
        For i As Integer = 0 To raw.Count() - 1
            Array.Append(values, New GitHubIssue(raw.ValueAt(i)))
        Next
        Me.Items = values
    End Sub
End Class

