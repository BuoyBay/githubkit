Public Class GitHubClient
    Private Property BaseURL As String
    Private Property Token As String
    Private Property VersionHeader As String
    Private Property RequestTimeout As Integer = 30
    Public Property LastResponse As GitHubResponseInfo

    Public Sub Constructor(token As String = "", apiBase As String = "https://api.github.com", allowInsecureLoopback As Boolean = False, apiVersion As String = "2026-03-10")
        CheckText(token, "Token")
        CheckText(apiBase, "API base")
        CheckText(apiVersion, "API version")
        If String.Contains(token, " ") Then Throw New InvalidArgumentException("Token cannot contain spaces")
        If String.Len(apiVersion) <> 10 Then Throw New InvalidArgumentException("Expected an API date version")
        For i As Integer = 0 To String.Len(apiVersion) - 1
            Dim ch As String = String.Substring(apiVersion, i, 1)
            If i = 4 Or i = 7 Then
                If ch <> "-" Then Throw New InvalidArgumentException("Invalid API date version")
            Else
                If Not String.Contains("0123456789", ch) Then Throw New InvalidArgumentException("Invalid API date version")
            End If
        Next
        Dim prefix As Integer = 8
        If String.StartsWith(apiBase, "http://") Then
            prefix = 7
        ElseIf Not String.StartsWith(apiBase, "https://") Then
            Throw New InvalidArgumentException("HTTPS API base required")
        End If
        If String.Contains(apiBase, "?") Or String.Contains(apiBase, "#") Or String.Contains(apiBase, "@") Or String.Contains(apiBase, "\\") Or String.Contains(apiBase, " ") Then Throw New InvalidArgumentException("Invalid API base")
        Dim rest As String = String.Substring(apiBase, prefix)
        Dim slash As Integer = String.IndexOf(rest, "/")
        Dim authority As String = rest
        If slash >= 0 Then authority = String.Left(rest, slash)
        If authority = "" Then Throw New InvalidArgumentException("API host is required")
        If prefix = 7 Then
            Dim host As String = String.LCase(String.Split(authority, ":")(0))
            If Not allowInsecureLoopback Or (host <> "localhost" And host <> "127.0.0.1") Then Throw New InvalidArgumentException("HTTP is allowed only for explicit loopback fixtures")
        End If
        For Each component As String In String.Split(rest, "/")
            If component = "." Or component = ".." Or String.Contains(component, "%") Then Throw New InvalidArgumentException("Invalid API base component")
        Next
        While String.EndsWith(apiBase, "/")
            apiBase = String.Left(apiBase, String.Len(apiBase) - 1)
        End While
        Me.BaseURL = apiBase
        Me.Token = token
        Me.VersionHeader = apiVersion
    End Sub

    Public Property TimeoutSeconds As Integer
        Get
            Return Me.RequestTimeout
        End Get
        Set
            If value < 1 Or value > 3600 Then Throw New InvalidArgumentException("Timeout must be in 1..3600 seconds")
            Me.RequestTimeout = value
        End Set
    End Property

    Private Function Request(method As String, route As String, payload As String) As JSONItem
        Me.LastResponse = Nil
        Dim connection As New URLConnection()
        connection.Timeout = Me.RequestTimeout
        connection.ConnectionTimeout = Me.RequestTimeout
        connection.VerifySSL = True
        connection.FollowRedirects = False
        connection.RequestHeaders.Set("Accept", "application/vnd.github+json")
        connection.RequestHeaders.Set("User-Agent", "Buoy-GitHubKit/0.1.0")
        connection.RequestHeaders.Set("X-GitHub-Api-Version", Me.VersionHeader)
        If Me.Token <> "" Then connection.RequestHeaders.Set("Authorization", "Bearer " + Me.Token)
        If payload <> "" Then connection.RequestHeaders.Set("Content-Type", "application/json")
        Dim text As String
        Try
            If payload = "" Then
                text = connection.Send(method, Me.BaseURL + route)
            Else
                text = connection.Send(method, Me.BaseURL + route, payload)
            End If
        Catch e As NetworkingException
            Throw New NetworkingException("GitHub transport failed")
        End Try
        Me.LastResponse = New GitHubResponseInfo(connection)
        If Me.Token <> "" Then
            Me.LastResponse.RequestID = String.Replace(Me.LastResponse.RequestID, Me.Token, "[redacted]")
            Me.LastResponse.RateLimitRemaining = String.Replace(Me.LastResponse.RateLimitRemaining, Me.Token, "[redacted]")
            Me.LastResponse.RateLimitReset = String.Replace(Me.LastResponse.RateLimitReset, Me.Token, "[redacted]")
            Me.LastResponse.RetryAfter = String.Replace(Me.LastResponse.RetryAfter, Me.Token, "[redacted]")
            Me.LastResponse.Link = String.Replace(Me.LastResponse.Link, Me.Token, "[redacted]")
        End If
        If connection.HTTPStatus < 200 Or connection.HTTPStatus >= 300 Then
            Dim message As String = "GitHub HTTP " + String.From(connection.HTTPStatus)
            Dim parsed As Optional Of JSONItem = Json.TryParse(text)
            If parsed.HasValue Then
                Dim detail As String = parsed.Value.Value("message").AsString().Or("")
                If detail <> "" Then message += ": " + detail
            End If
            If Me.Token <> "" Then message = String.Replace(message, Me.Token, "[redacted]")
            Throw New GitHubAPIException(message, Me.LastResponse)
        End If
        If connection.HTTPStatus = 204 Or text = "" Then Return JSONItem.Null()
        Dim parsed As Optional Of JSONItem = Json.TryParse(text)
        If Not parsed.HasValue Then Throw New GitHubAPIException("GitHub returned invalid JSON", Me.LastResponse)
        Return parsed.Value
    End Function

    Public Function GetRepository(owner As String, repository As String) As GitHubRepository
        Return New GitHubRepository(Me.Request("GET", RepositoryRoute(owner, repository), ""))
    End Function

    Public Function GetIssue(owner As String, repository As String, number As Integer) As GitHubIssue
        Return New GitHubIssue(Me.Request("GET", ItemRoute(owner, repository, "issues", number), ""))
    End Function

    Public Function ListIssues(owner As String, repository As String, page As Integer = 1, perPage As Integer = 30, state As String = "open") As GitHubIssuePage
        Dim raw As JSONItem = Me.Request("GET", RepositoryRoute(owner, repository) + "/issues" + PageSuffix(page, perPage, state), "")
        Return New GitHubIssuePage(raw, page, perPage, Me.LastResponse)
    End Function

    Public Function CreateIssue(owner As String, repository As String, title As String, body As String = "") As GitHubIssue
        If String.Trim(title) = "" Then Throw New InvalidArgumentException("Issue title is required")
        Dim payload As JSONItem = JSONItem.NewObject()
        payload.Value("title") = title
        payload.Value("body") = body
        Return New GitHubIssue(Me.Request("POST", RepositoryRoute(owner, repository) + "/issues", Json.Stringify(payload)))
    End Function

    ' PATCH payload preserves omitted vs null fields; only allowed issue fields are accepted.
    Public Function UpdateIssue(owner As String, repository As String, number As Integer, changes As JSONItem) As GitHubIssue
        If changes = Nil Then Throw New InvalidArgumentException("Issue changes are required")
        If Not changes.IsObject() Or changes.Count() = 0 Then Throw New InvalidArgumentException("Issue changes must be a nonempty object")
        For Each key As String In changes.Keys()
            If Not Array.Contains(["title", "body", "state", "state_reason", "milestone", "labels", "assignees"], key) Then Throw New InvalidArgumentException("Unsupported issue change field: " + key)
        Next
        Return New GitHubIssue(Me.Request("PATCH", ItemRoute(owner, repository, "issues", number), Json.Stringify(changes)))
    End Function

    Public Function ListComments(owner As String, repository As String, number As Integer, page As Integer = 1, perPage As Integer = 30) As GitHubCommentPage
        Dim raw As JSONItem = Me.Request("GET", ItemRoute(owner, repository, "issues", number) + "/comments" + PageSuffix(page, perPage, ""), "")
        Return New GitHubCommentPage(raw, page, perPage, Me.LastResponse)
    End Function

    Public Function CreateComment(owner As String, repository As String, number As Integer, body As String) As GitHubComment
        If String.Trim(body) = "" Then Throw New InvalidArgumentException("Comment body is required")
        Dim payload As JSONItem = JSONItem.NewObject()
        payload.Value("body") = body
        Return New GitHubComment(Me.Request("POST", ItemRoute(owner, repository, "issues", number) + "/comments", Json.Stringify(payload)))
    End Function

    Public Sub DeleteComment(owner As String, repository As String, commentID As Integer)
        Dim ignored As JSONItem = Me.Request("DELETE", ItemRoute(owner, repository, "issues/comments", commentID), "")
    End Sub

    Public Function ListLabels(owner As String, repository As String, page As Integer = 1, perPage As Integer = 30) As GitHubLabelPage
        Dim raw As JSONItem = Me.Request("GET", RepositoryRoute(owner, repository) + "/labels" + PageSuffix(page, perPage, ""), "")
        Return New GitHubLabelPage(raw, page, perPage, Me.LastResponse)
    End Function

    Public Function ListMilestones(owner As String, repository As String, page As Integer = 1, perPage As Integer = 30, state As String = "open") As GitHubMilestonePage
        Dim raw As JSONItem = Me.Request("GET", RepositoryRoute(owner, repository) + "/milestones" + PageSuffix(page, perPage, state), "")
        Return New GitHubMilestonePage(raw, page, perPage, Me.LastResponse)
    End Function

    Public Function ListPullRequests(owner As String, repository As String, page As Integer = 1, perPage As Integer = 30, state As String = "open") As GitHubPullRequestPage
        Dim raw As JSONItem = Me.Request("GET", RepositoryRoute(owner, repository) + "/pulls" + PageSuffix(page, perPage, state), "")
        Return New GitHubPullRequestPage(raw, page, perPage, Me.LastResponse)
    End Function

    Public Function GetPullRequest(owner As String, repository As String, number As Integer) As GitHubPullRequest
        Return New GitHubPullRequest(Me.Request("GET", ItemRoute(owner, repository, "pulls", number), ""))
    End Function
End Class
